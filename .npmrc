# pnpm workspace configuration

# Enable strict peer dependencies (recommended)
strict-peer-dependencies=false

# Auto-install peer dependencies
auto-install-peers=true

# Hoist Storybook and React dependencies to workspace root
# This fixes module resolution issues with Storybook internals
public-hoist-pattern[]=*storybook*
public-hoist-pattern[]=*react*
public-hoist-pattern[]=*react-dom*
public-hoist-pattern[]=scheduler
public-hoist-pattern[]=@mdx-js/*

# Shamefully hoist for Storybook compatibility
# This ensures Storybook can find all its internal dependencies
shamefully-hoist=true
